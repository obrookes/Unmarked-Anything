# Shared config for hpc/scripts/run_full_pipeline.sh. Copy this file, edit the values, then:
#   PIPELINE_ENV=/path/to/my.env hpc/scripts/run_full_pipeline.sh
#
# All paths may be relative to REPO_ROOT unless noted otherwise.

# --- Repo / data locations ---------------------------------------------------
REPO_ROOT="$HOME/Unmarked-Anything"
VIDEO_DIR="assets/videos"                      # main chimp-video directory (dap3 stage C)
REFERENCE_ROOT="$HOME/wcf-pps-p3"              # project root that reference_video_map.csv's
                                                # reference_dir paths are relative to
REFERENCE_MAP="configs/pss_p3/reference_video_map.csv"  # find_sign_frames.py --reference-map
OUT_ROOT="$REPO_ROOT/hpc/runs/pss_p3"          # everything this pipeline writes goes under here

# --- Sign-frame scan (stage A/A') ---------------------------------------------
SCAN_FPS="2"                                   # find_sign_frames.py --scan-fps

# --- SAM3 / DA3 settings (SAME for reference calibration and main runs) ------
SAM3_CKPT="weights/sam3/sam3-safari-neg-parents.pt"
SAM3_BACKEND="official"                        # official|ultralytics
SAM3_DET_THRESHOLD="0.5"
CALIB_SAM3_PROMPT="person"                     # build_reference.py --sam3-prompt (stage B)
DA3_MODEL_ID="depth-anything/DA3NESTED-GIANT-LARGE"
DA3_MODE="batch"                               # batch|stream|all_frames
DA3_BATCH="48"
TARGET_FPS="6.0"
DEPTH_INTERVAL_S="2"                           # dap3_cli.py --depth-interval-seconds (stage C)
MIN_DEPTH="1"                                  # build_reference.py --min-depth (stage B)
MAX_DEPTH="25"                                 # build_reference.py --max-depth (stage B)

# The main run's prompt is configurable -- default matches hpc/configs/job_manifest.tsv.
MAIN_PROMPTS="ape"

# --- apply_calibration (stage E1/E1') ------------------------------------------
EXTRINSIC_RECALIBRATION="0"                    # 1 to enable apply.py --extrinsic-recalibration
LIGHTGLUE_WEIGHTS=""                           # apply.py --lightglue-weights (only if enabled above)

# --- Containers / envs --------------------------------------------------------
DAP3_SAM3_CONTAINER="$REPO_ROOT/envs/containers/dap3-sam3.sif"   # official backend (stages B, C, E1)
DAP3_CONDA_ENV="dap3-stream"                                     # ultralytics backend fallback
VLM_CONTAINER=""                                                 # apptainer .sif for find_sign_frames.sh /
VLM_CONDA_ENV=""                                                 # mask_verify_array.sh (set one)
VLM_MODEL="qwen"                                                 # qwen (1 GPU) | glm (GLM-5.3-Flash, 4 GPUs)
VLM_GPUS="1"                                                     # GPUs per VLM task = vLLM TP size (4 for glm)
R_CONDA_ENV=""                                                   # env with Distance/dplyr/activity/yaml
R_MODULE=""                                                      # or an R environment module

# --- Shared cache / misc ------------------------------------------------------
HF_HOME="/scratch/$USER/hf-cache"

# --- Slurm placeholders (edit for your account/partition) --------------------
SLURM_PARTITION=""
SLURM_ACCOUNT=""

# --- Array sharding ------------------------------------------------------------
FIND_SIGN_NUM_SHARDS="1"
APPLY_NUM_SHARDS="1"
MASK_VERIFY_NUM_SHARDS="1"
